# ─── Cluster Neusi ─────────────────────────────────────────────
# IPs de las máquinas del cluster
NODE_PRODUCCION=192.168.0.100
NODE_DESARROLLO=192.168.0.101
NODE_PRUEBAS=192.168.0.102
NODE_GATEWAY_IOT=192.168.0.103
NODE_DATOS=192.168.0.104
NODE_KALI=192.168.0.105
# NODE_EDGE=192.168.10.10  # RPi5 en VLAN AMI experimental (futuro)

# ─── MQTT broker (.101) ────────────────────────────────────────
# El broker urbia-mqtt (.101) está configurado con allow_anonymous=true.
# Dejar MQTT_USERNAME y MQTT_PASSWORD vacíos: los clientes deben
# conectar SIN flags -u/-P (modo anónimo).
#
# DEUDA TÉCNICA (no urgente): habilitar autenticación + ACLs en el
# broker antes de la defensa doctoral. Aceptable mientras la red sea
# el cluster cerrado Neusi; inaceptable para producción.
MQTT_HOST=192.168.0.101
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TELEMETRY=urbia/ami/+/telemetry
MQTT_TOPIC_ANOMALY=urbia/ami/+/anomaly

# ─── PostgreSQL (.102) ─────────────────────────────────────────
POSTGRES_HOST=192.168.0.102
POSTGRES_PORT=5432
POSTGRES_DB=urbia
POSTGRES_USER=urbia
POSTGRES_PASSWORD=changeme

# ─── MongoDB (.102) ────────────────────────────────────────────
MONGO_HOST=192.168.0.102
MONGO_PORT=27017
MONGO_DB=urbia_telemetry
MONGO_USER=urbia
MONGO_PASSWORD=changeme

# ─── Redis (.102) ──────────────────────────────────────────────
REDIS_HOST=192.168.0.102
REDIS_PORT=6379

# ─── MinIO (.102) ──────────────────────────────────────────────
MINIO_ENDPOINT=192.168.0.102:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET_EXPERIMENTS=urbia-experiments

# ─── Backend (.102) ────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true

# ─── SDN Controller (.102) ─────────────────────────────────────
RYU_HOST=0.0.0.0
RYU_PORT=6633
RYU_API_PORT=8080

# ─── Observabilidad ────────────────────────────────────────────
PROMETHEUS_HOST=192.168.0.105
PROMETHEUS_PORT=9090
GRAFANA_HOST=192.168.0.100
GRAFANA_PORT=3000

# ─── NAS para backups (.104) ───────────────────────────────────
NAS_HOST=192.168.0.104
NAS_PATH=/mnt/nas-wd
