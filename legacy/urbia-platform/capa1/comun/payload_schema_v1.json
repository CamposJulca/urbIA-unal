{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UrbIA Telemetry Payload v1",
  "description": "Esquema de telemetría para medidores eléctricos urbanos - Manizales",
  "type": "object",
  "required": [
    "device_id", "device_type", "zona", "timestamp_utc",
    "voltaje_v", "corriente_a", "potencia_kw", "frecuencia_hz",
    "factor_potencia", "lat", "lon", "estado",
    "nodo_origen", "lenguaje", "seed"
  ],
  "properties": {
    "device_id": {
      "type": "string",
      "pattern": "^urbia-(cen|chi|ena|pal|pgr|uni)-(mon|tri)-[0-9]{4}$",
      "description": "ID único del medidor. Formato: urbia-{zona_corta}-{tipo}-{NNNN}"
    },
    "device_type": {
      "type": "string",
      "enum": ["mono", "trifasico"]
    },
    "zona": {
      "type": "string",
      "enum": ["centro", "chipre", "la_enea", "palermo", "palogrande", "universitario"]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "voltaje_v": {
      "type": "number",
      "minimum": 187.0,
      "maximum": 253.0
    },
    "corriente_a": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 60.0
    },
    "potencia_kw": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 30.0
    },
    "frecuencia_hz": {
      "type": "number",
      "minimum": 57.0,
      "maximum": 63.0
    },
    "factor_potencia": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "lat": {
      "type": "number",
      "minimum": 5.03,
      "maximum": 5.12
    },
    "lon": {
      "type": "number",
      "minimum": -75.55,
      "maximum": -75.44
    },
    "estado": {
      "type": "string",
      "enum": ["activo", "falla", "mantenimiento", "anomalia_voltaje", "anomalia_frecuencia", "corte", "desconectado"]
    },
    "nodo_origen": {
      "type": "string",
      "enum": ["192.168.0.103", "192.168.0.104", "192.168.0.105"]
    },
    "lenguaje": {
      "type": "string",
      "enum": ["python", "cpp", "java"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
