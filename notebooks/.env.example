# Plantilla para el .env LOCAL del entorno de notebooks.
# Copiar a .env y reemplazar el placeholder por un token fuerte.
# El archivo .env NO se commitea (cubierto por .gitignore raíz).

# Token de autenticación para JupyterLab. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JUPYTER_TOKEN=REPLACE_WITH_STRONG_TOKEN
